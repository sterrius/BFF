{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "goodbye-route": {
        "ClusterId": "app-goodbye-cluster",
        "Order": 0,
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/app/goodbye"
        },
        "Transforms": [
          { "PathRemovePrefix": "/app" }
        ]
      },
      "root-route": {
        "ClusterId": "root-cluster",
        "Order": 2,
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "app-goodbye-cluster": {
        "Destinations": {
          "app-destination": {
            "Address": "http://localhost:4200/"
          }
        }
      },
      "root-cluster": {
        "Destinations": {
          "app-destination": {
            "Address": "http://localhost:4200/"
          }
        }
      }
    }
  }
}